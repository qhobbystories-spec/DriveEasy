# ============================================
# AMK Motors — Render (Backend) + Vercel (Frontend)
# ============================================

# ---------- Database ----------
# Render provides this automatically from the PostgreSQL service
DATABASE_URL=postgres://user:password@host:5432/amk_motors_db

# ---------- JWT ----------
# Render can auto-generate these, or set manually:
JWT_SECRET=your-64-char-random-string-here
JWT_REFRESH_SECRET=a-different-64-char-random-string

# ---------- Server ----------
PORT=5000
NODE_ENV=production

# ---------- Frontend URL ----------
# Your Vercel deployment URL
FRONTEND_URL=https://amk-motors.vercel.app
BACKEND_URL=https://amk-backend.onrender.com

# ---------- Email (SMTP) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM=noreply@amkmotors.com

# ---------- Rate Limiting ----------
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# ---------- Logging ----------
LOG_LEVEL=info
