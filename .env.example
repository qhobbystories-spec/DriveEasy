# ============================================
# AMK Motors & AutoCare — Production Environment
# ============================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================

# ---------- Database ----------
MYSQL_ROOT_PASSWORD=generate-a-strong-root-password
MYSQL_DATABASE=amk_motors_db
MYSQL_USER=amk_app
MYSQL_PASSWORD=generate-a-strong-app-password

# ---------- JWT ----------
# Generate with: openssl rand -base64 48
JWT_SECRET=generate-a-64-char-random-string
JWT_REFRESH_SECRET=generate-a-different-64-char-random-string

# ---------- Server ----------
PORT=5000
NODE_ENV=production

# ---------- Frontend URL ----------
# Your domain where the React app is served
FRONTEND_URL=https://yourdomain.com
BACKEND_URL=https://api.yourdomain.com

# ---------- Email (SMTP) ----------
# Gmail: use an App Password, not your real password
# Outlook: same — App Password required
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM=noreply@amkmotors.com

# ---------- Rate Limiting ----------
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# ---------- Logging ----------
LOG_LEVEL=info

# ---------- Docker ----------
# Set to 80 for production, or use a reverse proxy (Cloudflare, etc.)
HTTP_PORT=80
